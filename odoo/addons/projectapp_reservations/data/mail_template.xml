<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_reservation_confirmed" model="mail.template">
            <field name="name">Reserva de mesa: confirmación al cliente</field>
            <field name="model_id" ref="projectapp_reservations.model_waiter_reservation"/>
            <field name="subject">Reserva {{ object.name }} confirmada en {{ user.company_id.name }}</field>
            <field name="email_from">{{ user.company_id.partner_id.email_formatted or user.email_formatted or '' }}</field>
            <field name="email_to">{{ object.customer_email }}</field>
            <field name="lang">{{ user.lang }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
<div style="font-family: Open Sans, Arial, sans-serif; color: #0F172A; font-size: 14px;">
    <p>Hola <t t-out="object.customer_name"/>,</p>
    <p>Tu reserva está confirmada. Estos son los detalles:</p>
    <table style="border-collapse: collapse;">
        <tr><td style="padding: 4px 12px 4px 0; color: #475569;">Reserva</td><td style="padding: 4px 0;"><strong t-out="object.name"/></td></tr>
        <tr><td style="padding: 4px 12px 4px 0; color: #475569;">Fecha</td><td style="padding: 4px 0;" t-out="format_date(object.date)"/></tr>
        <tr><td style="padding: 4px 12px 4px 0; color: #475569;">Hora</td><td style="padding: 4px 0;" t-out="object.waiter_time_label()"/></tr>
        <tr><td style="padding: 4px 12px 4px 0; color: #475569;">Mesa</td><td style="padding: 4px 0;" t-out="', '.join(object.table_ids.mapped('display_name')) or object.table_id.display_name"/></tr>
        <tr><td style="padding: 4px 12px 4px 0; color: #475569;">Personas</td><td style="padding: 4px 0;" t-out="object.people"/></tr>
        <tr><td style="padding: 4px 12px 4px 0; color: #475569;">Silla de bebé</td><td style="padding: 4px 0;" t-out="'Sí' if object.baby_chair else 'No'"/></tr>
    </table>
    <t t-if="object.preorder_id">
        <p>Platos pre-pedidos:</p>
        <ul>
            <li t-foreach="object.preorder_id.lines" t-as="line">
                <t t-out="line.full_product_name or line.product_id.display_name"/> × <t t-out="int(line.qty)"/>
                <t t-if="line.customer_note"> — <t t-out="line.customer_note"/></t>
            </li>
        </ul>
        <p>Total estimado: <strong t-out="format_amount(object.amount_total, object.currency_id)"/></p>
    </t>
    <t t-if="object.notes"><p>Notas: <t t-out="object.notes"/></p></t>
    <p>Te esperamos.<br/><t t-out="user.company_id.name"/></p>
</div>
            </field>
        </record>
    </data>
</odoo>
