<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Quita «Powered by Odoo» del recibo del cliente.

        Se hace por herencia de plantilla y no por CSS porque el bloque
        se imprime: ocultarlo visualmente deja el nodo en el ticket y
        algunas impresoras térmicas lo interpretan como línea en blanco.
        Con `position="replace"` sin contenido, el nodo desaparece.
    -->
    <t t-name="projectapp_pos_design.OrderReceipt"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('footer-powered-by')]" position="replace"/>
    </t>

</templates>
