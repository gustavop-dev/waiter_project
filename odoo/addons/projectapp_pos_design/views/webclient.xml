<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Favicon propio.

        La plantilla base resuelve `t-att-href="x_icon or '/web/static/img/favicon.ico'"`.
        Sin el módulo `website` nadie define `x_icon`, así que el navegador
        muestra el favicon de Odoo. Se sustituye el atributo por el nuestro.
    -->
    <template id="layout_favicon" inherit_id="web.layout" name="ProjectApp · favicon">
        <xpath expr="//link[@rel='shortcut icon']" position="attributes">
            <attribute name="t-att-href">'/projectapp_pos_design/static/src/img/favicon.png'</attribute>
        </xpath>
    </template>

</odoo>
