<odoo>
    <data noupdate="1">
        <record id="ir_cron_waiter_low_stock" model="ir.cron">
            <field name="name">Waiter: avisar stock bajo</field>
            <field name="model_id" ref="model_waiter_notification"/>
            <field name="state">code</field>
            <field name="code">model.waiter_check_low_stock()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
