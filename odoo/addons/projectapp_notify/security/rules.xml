<odoo>
    <data noupdate="1">
        <!-- Cada usuario ve las notificaciones generales (sin usuario) y las suyas. -->
        <record id="waiter_notification_rule_user" model="ir.rule">
            <field name="name">Notificaciones Waiter: generales o propias</field>
            <field name="model_id" ref="model_waiter_notification"/>
            <field name="domain_force">['|', ('user_id', '=', False), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        </record>
        <record id="waiter_notification_rule_manager" model="ir.rule">
            <field name="name">Notificaciones Waiter: administrador ve todas</field>
            <field name="model_id" ref="model_waiter_notification"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
        </record>
    </data>
</odoo>
