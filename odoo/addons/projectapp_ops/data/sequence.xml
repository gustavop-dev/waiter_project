<odoo>
    <data noupdate="1">
        <!-- Código visible del empleado (kit: "Employee ID"): WT-0001, WT-0002… Se asigna al crear el empleado. -->
        <record id="seq_waiter_employee_code" model="ir.sequence">
            <field name="name">Código de empleado Waiter</field>
            <field name="code">waiter.employee.code</field>
            <field name="prefix">WT-</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
