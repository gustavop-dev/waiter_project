# Copiar a .env y rellenar. El archivo real NUNCA se versiona.
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CAMBIAR

# Correo saliente (invitaciones y códigos de acceso). GoDaddy: smtpout.secureserver.net 465 ssl.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_ENCRYPTION=ssl
SMTP_USER=team@example.com
SMTP_PASSWORD=replace
SMTP_FROM=team@example.com
