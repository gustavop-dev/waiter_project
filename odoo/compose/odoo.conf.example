[options]
; Copiar a odoo.conf y rellenar. El archivo real NUNCA se versiona.

; Contraseña maestra: protege crear, borrar y descargar bases de datos.
; Sin ella, Odoo usa una por defecto y cualquiera puede borrar un inquilino.
admin_passwd = CAMBIAR_POR_UNA_CLAVE_LARGA_Y_ALEATORIA

; Credenciales de Postgres.
db_host = db
db_user = odoo
db_password = CAMBIAR

; Desactiva el listado y el gestor de bases por HTTP.
; Con una base por restaurante, listar bases es filtrar la lista de clientes.
list_db = False

; Cada despliegue sirve una sola base.
dbfilter = ^projectapp$

; Detrás de un proxy inverso en producción.
proxy_mode = False
